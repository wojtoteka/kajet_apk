<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Od Androida 11 aplikacja nie widzi innych aplikacji bez pytania.
         Udostepnianie i otwieranie eksportu musi moc znalezc odbiorcow. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".KajetApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kajet">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Kajet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Powrót z logowania na stronie (Custom Tabs → kajet://auth?code=…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kajet" android:host="auth" />
            </intent-filter>
            <!--
              „Udostępnij" / „Otwórz w". Kajet zgłasza się WYŁĄCZNIE do tego,
              co naprawdę umie pokazać po skopiowaniu pliku do biblioteki:
                - tekst i kod - edytor kodu czyta plik jako UTF-8,
                - jpg / png / gif / webp - podgląd zdjęcia,
                - PDF - podgląd stron.
              Żadnego mimeType="*/*". Z nim system proponował Kajet do .apk,
              .zip czy filmu, a taki plik i tak kończył na komunikacie, że nic
              go nie otworzy.

              Spis typów ma się zgadzać z OtherFileKind.of i CodeLanguage - to
              one rozstrzygają, na który ekran trafi skopiowany plik. Po
              dopisaniu tam nowego rodzaju trzeba dopisać typ MIME i tutaj,
              inaczej szuflada systemowa Kajetu nie pokaże.

              Typy MIME stoją w osobnym filtrze niż kajet://auth, bo tamten
              adres przychodzi bez typu i w jednym filtrze by nie pasował.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Tekst i kod. text/* obejmuje text/plain, text/markdown,
                     text/csv, text/html, text/xml i typy języków
                     (text/x-python, text/x-java-source i podobne). -->
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/x-shellscript" />
                <data android:mimeType="application/x-httpd-php" />
                <!-- Zdjęcia: dokładnie te cztery formaty, które czyta podgląd
                     (OtherFileKind.IMAGES). image/* wpuszczałoby też np. .heic,
                     a ten kończy na komunikacie o binarce. -->
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/webp" />
                <!-- SVG to znaczniki, więc idzie do edytora kodu, a nie do
                     podglądu zdjęcia. -->
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- „Otwórz w" z menedżera plików i z pobranych. Ten sam spis
                 typów co wyżej. Schematy i typy mnożą się przez siebie, więc
                 content: i file: dotyczą każdego z nich. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/x-shellscript" />
                <data android:mimeType="application/x-httpd-php" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Ekran po awarii. Osobny proces (:blad), bo po nieobsluzonym wyjatku
             watek glowny starego procesu jest martwy i nic by sie w nim juz
             nie narysowalo. -->
        <activity
            android:name=".awaria.ErrorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":blad"
            android:theme="@style/Theme.Kajet" />

        <!-- Udostepnia pliki innym aplikacjom: zdjecie z aparatu i gotowy eksport. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pliki"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sciezki_plikow" />
        </provider>
    </application>

</manifest>
