<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup (API 31+) i przekazanie urządzenia: to samo co backup_rules.xml.
  Trwałe uprawnienie SAF nie wraca razem z danymi, więc adres folderu i spis
  Room bez niego tylko szkodzą. Plików notatek w pamięci aplikacji nie ruszamy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kajet_saf.xml"/>
        <exclude domain="database" path="kajet-index.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kajet_saf.xml"/>
        <exclude domain="database" path="kajet-index.db"/>
    </device-transfer>
</data-extraction-rules>
