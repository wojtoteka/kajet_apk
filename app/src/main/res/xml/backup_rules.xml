<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup nie przenosi trwałego uprawnienia SAF do wybranego folderu.
  Przywrócony adres drzewa i spis Room bez tego uprawnienia pomijają wybór
  folderu i pokazują pustą bibliotekę, choć notatki na dysku są nietknięte.

  Wyłączamy tylko ten adres i podręczny spis. Same pliki notatek leżą
  w folderze wskazanym przez użytkownika, poza katalogiem aplikacji -
  kopii zapasowej aplikacji i tak ich nie obejmują. Gdyby kiedyś trafiły
  do pamięci prywatnej Kajetu, ta reguła ich nie wyłącza.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="kajet_saf.xml"/>
    <exclude domain="database" path="kajet-index.db"/>
</full-backup-content>
